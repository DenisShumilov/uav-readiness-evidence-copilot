{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denisshumilov.github.io/uav-readiness-evidence-copilot/schemas/evidence-graph.schema.json",
  "title": "Evidence graph",
  "description": "Output of buildEvidenceGraphFromBundle(). Documentation QA evidence graph.",
  "type": "object",
  "required": [
    "evidenceGraph",
    "evidenceSources",
    "evidenceClaims",
    "evidenceLocks",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "evidenceGraph": {
      "type": "object",
      "required": [
        "id",
        "artifactIds",
        "evidenceSourceIds",
        "evidenceClaimIds",
        "links",
        "generatedAt",
        "synthetic"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
        "artifactIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" }
        },
        "evidenceSourceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" }
        },
        "evidenceClaimIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claimId", "evidenceSourceId", "relation"],
            "additionalProperties": false,
            "properties": {
              "claimId": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
              "evidenceSourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
              },
              "relation": {
                "type": "string",
                "enum": ["supports", "partially_supports", "conflicts"]
              }
            }
          }
        },
        "generatedAt": { "type": "string", "format": "date-time" },
        "synthetic": { "type": "boolean" }
      }
    },
    "evidenceSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "artifactId",
          "label",
          "sourceType",
          "excerpt",
          "confidence",
          "synthetic"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
          "artifactId": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 160 },
          "sourceType": {
            "type": "string",
            "enum": [
              "document",
              "table",
              "note",
              "log",
              "checklist",
              "generated"
            ]
          },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "synthetic": { "type": "boolean" }
        }
      }
    },
    "evidenceClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "claimType",
          "status",
          "evidenceSourceIds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "claimType": {
            "type": "string",
            "enum": [
              "artifact_presence",
              "component_record",
              "wiring_documentation",
              "config_documentation",
              "test_record",
              "qa_note",
              "training_record",
              "maintenance_record",
              "safety_boundary"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["verified", "partial", "locked", "conflict"]
          },
          "evidenceSourceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" }
          },
          "lockReason": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "verified" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "evidenceSourceIds": { "minItems": 1 }
              }
            }
          },
          {
            "if": {
              "properties": { "status": { "const": "locked" } },
              "required": ["status"]
            },
            "then": {
              "required": ["lockReason"],
              "properties": {
                "lockReason": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    },
    "evidenceLocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claimId",
          "reason",
          "missingEvidence",
          "severity",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
          "claimId": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "missingEvidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "critical"]
          },
          "status": {
            "type": "string",
            "const": "locked"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "totalClaims",
        "totalSources",
        "totalLocks",
        "verifiedCount",
        "partialCount",
        "lockedCount",
        "conflictCount"
      ],
      "additionalProperties": false,
      "properties": {
        "totalClaims": { "type": "integer", "minimum": 0 },
        "totalSources": { "type": "integer", "minimum": 0 },
        "totalLocks": { "type": "integer", "minimum": 0 },
        "verifiedCount": { "type": "integer", "minimum": 0 },
        "partialCount": { "type": "integer", "minimum": 0 },
        "lockedCount": { "type": "integer", "minimum": 0 },
        "conflictCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
