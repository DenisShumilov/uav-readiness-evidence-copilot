{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denisshumilov.github.io/uav-readiness-evidence-copilot/schemas/readiness-assessment.schema.json",
  "title": "Readiness assessment",
  "description": "Output of evaluateReadiness(). Documentation readiness only — never operational or flight readiness.",
  "type": "object",
  "required": [
    "readinessScore",
    "formula",
    "findings",
    "warnings",
    "lockedCriticalItems",
    "engineAdjustments",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "readinessScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "formula": {
      "type": "object",
      "required": ["base", "deductions"],
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "integer",
          "const": 100
        },
        "deductions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "count", "pointsEach", "total"],
            "additionalProperties": false,
            "properties": {
              "reason": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 },
              "pointsEach": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "severity",
          "status",
          "evidenceClaimIds",
          "lockIds",
          "explanation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "category": {
            "type": "string",
            "enum": [
              "artifact_completeness",
              "evidence_quality",
              "traceability",
              "safety_boundary",
              "qa_process"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "critical"]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "blocked", "not_tested"]
          },
          "evidenceClaimIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" }
          },
          "lockIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" }
          },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lockedCriticalItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "engineAdjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claimId", "assertedStatus", "derivedStatus", "reason"],
        "additionalProperties": false,
        "properties": {
          "claimId": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
          "assertedStatus": {
            "type": "string",
            "enum": ["verified", "partial", "locked", "conflict"]
          },
          "derivedStatus": {
            "type": "string",
            "enum": ["verified", "partial", "locked", "conflict"]
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "verifiedCount",
        "partialCount",
        "lockedCount",
        "conflictCount",
        "engineAdjustedCount",
        "missingArtifacts",
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "verifiedCount": { "type": "integer", "minimum": 0 },
        "partialCount": { "type": "integer", "minimum": 0 },
        "lockedCount": { "type": "integer", "minimum": 0 },
        "conflictCount": { "type": "integer", "minimum": 0 },
        "engineAdjustedCount": { "type": "integer", "minimum": 0 },
        "missingArtifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "explanation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
